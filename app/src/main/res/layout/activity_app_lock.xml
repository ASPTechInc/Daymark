<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/pin_display_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:drawablePadding="10dp"
        android:gravity="center"
        android:text="@string/app_lock_title"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        app:drawableTint="#FFFFFF"
        app:drawableTopCompat="@drawable/ic_lock" />

    <TextView
        android:id="@+id/pin_display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="90dp"
        android:drawablePadding="10dp"
        android:gravity="center"
        android:letterSpacing="0.4"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="32sp" />

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:orientation="horizontal"
        android:rowCount="4">

        <Button
            android:id="@+id/btn_1"
            style="@style/Widget.Daymark.AppLockKeyButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="@string/keypad_num_1" />

        <Button
            android:id="@+id/btn_2"
            style="@style/Widget.Daymark.AppLockKeyButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="@string/keypad_num_2" />

        <Button
            android:id="@+id/btn_3"
            style="@style/Widget.Daymark.AppLockKeyButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="@string/keypad_num_3" />

        <Button
            android:id="@+id/btn_4"
            style="@style/Widget.Daymark.AppLockKeyButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="@string/keypad_num_4" />

        <Button
            android:id="@+id/btn_5"
            style="@style/Widget.Daymark.AppLockKeyButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="@string/keypad_num_5" />

        <Button
            android:id="@+id/btn_6"
            style="@style/Widget.Daymark.AppLockKeyButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="@string/keypad_num_6" />

        <Button
            android:id="@+id/btn_7"
            style="@style/Widget.Daymark.AppLockKeyButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="@string/keypad_num_7" />

        <Button
            android:id="@+id/btn_8"
            style="@style/Widget.Daymark.AppLockKeyButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="@string/keypad_num_8" />

        <Button
            android:id="@+id/btn_9"
            style="@style/Widget.Daymark.AppLockKeyButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="@string/keypad_num_9" />

        <Button
            android:id="@+id/btn_clear"
            style="@style/Widget.Daymark.AppLockKeyButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="@string/keypad_clear_btn"
            android:textColor="?attr/colorOnMenuContainer"
            app:backgroundTint="?attr/colorSecondaryContainer"
            app:cornerRadius="6dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="2dp" />

        <Button
            android:id="@+id/btn_0"
            style="@style/Widget.Daymark.AppLockKeyButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="@string/keypad_num_0" />

        <Button
            android:id="@+id/btn_enter"
            style="@style/Widget.Daymark.AppLockKeyButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="6dp"
            android:text="@string/keypad_confirm_btn"
            app:backgroundTint="?attr/colorPrimaryContainer"
            app:tint="?attr/colorOnPrimaryContainer" />
    </GridLayout>
</LinearLayout>
